# Local development only. Production credentials must be provisioned separately.
POSTGRES_PASSWORD=local-development-only
STORAGE_ACCESS_KEY=neerikkha
STORAGE_SECRET_KEY=local-storage-only
OCR_ENGINE=gemini
GEMINI_MODEL=gemini-3.5-flash
# Independent reads per document (1-3). Two doubles Gemini calls and time.
GEMINI_PASSES=2
TESSERACT_FALLBACK=false
# Put the Gemini key in .secrets/gemini-api-key.txt, never in frontend variables.
